    "test:flowseal-version": "node --test scripts/flowseal-version.test.mjs",
    "test:i18n": "node --test scripts/i18n.test.mjs",
    "test:update-privacy": "node --test scripts/update-check-privacy.test.mjs",
    "test:status": "node --test scripts/status-check.test.mjs",
    "sign-core-channel": "tauri signer sign core-channel/stable.json",
